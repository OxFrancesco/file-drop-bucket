+// Native AppKit dragging requires WindowServer routing. PID-posted events can
+// return successfully without a window or an NSDraggingSession. Do not silently
+// substitute that path when permission to move the real pointer is absent.
+func requireNativeDragPermission(environment: [String: String]) throws {
+    let dragConsent = environment["OPEN_COMPUTER_USE_ALLOW_NATIVE_DRAG"]?
+        .trimmingCharacters(in: .whitespacesAndNewlines).lowercased() ?? ""
+    guard ["1", "true", "yes", "on"].contains(dragConsent)
+        || globalPointerFallbacksEnabled(environment: environment) else {
+        throw ComputerUseError.message(
+            "Native drag requires OPEN_COMPUTER_USE_ALLOW_NATIVE_DRAG=1. It moves the real pointer and may change focus. Inspect source and destination first. Accessibility permission is still required. No drag events were sent."
+        )
+    }
+}
